# Copy to .env (git-ignored): cp .env.example .env
# docker compose loads .env automatically.

# Host port for the API
HTTP_PORT=8080

# PostGIS
POSTGRES_USER=disaster
POSTGRES_PASSWORD=disaster
POSTGRES_DB=disaster

# Optional LLM location extraction (any OpenAI-compatible endpoint).
# Leave LLM_API_KEY empty to use the deterministic gazetteer fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Used only by scripts/smoke_test.py
BASE_URL=http://localhost:8080
